{
  "name": "nextjs-starter",
  "description": "A bun only Next.js starter template.",
  "license": "MIT",
  "version": "0.1.1",
  "type": "module",
  "readme": "README.md",
  "private": true,
  "scripts": {
    "build": "bun --bun next build",
    "check:build": "bun check -p tsconfig.build.json",
    "clean": "bun ./scripts/clean.ts .next next-env.d.ts",
    "dev": "bun --bun next dev",
    "start": "bun --bun next start",
    "typecheck": "bun typegen && bun check:build",
    "typegen": "bun --bun next typegen"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@thesvg/react": "^3.4.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.59.0",
    "motion": "^14.3.0",
    "next": "^16.4.2",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "schema-dts": "^2.1.0",
    "shadcn": "^4.22.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4.3.3",
    "@types/bun": "^1.4.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.4.3",
  "engines": {
    "bun": ">=1.4.3",
    "runtime": {
      "name": "bun",
      "version": ">=1.4.3",
      "onFail": "error"
    }
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": ">=1.4.3",
      "onFail": "error"
    },
    "runtime": {
      "name": "bun",
      "onFail": "error",
      "version": ">=1.4.3"
    }
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
